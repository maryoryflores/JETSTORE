# ============================================================
# JetStore Digital - Variables de entorno (backend Spring Boot)
# Copia este archivo a .env y ajusta los valores.
# ============================================================

# --- Base de datos PostgreSQL ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jetstore
# SPRING_DATASOURCE_USERNAME=jetstore_admin
# SPRING_DATASOURCE_PASSWORD=1234

# --- Recuperación de contraseña ---
# URL pública del frontend (base del enlace /reset-password?token=...)
FRONTEND_URL=http://localhost:3000

# Horas de validez del enlace de recuperación
RECUPERACION_EXPIRACION_HORAS=1

# Si es true intenta enviar correos. Sin SMTP configurado, el enlace
# se muestra en la consola del backend.
MAIL_HABILITADO=true

# Remitente de los correos
MAIL_REMITENTE=no-responder@jetstore.pe

# --- Mercado Pago (opcional) ---
# Obtén tu ACCESS_TOKEN en https://www.mercadopago.com.pe/developers/panel/app
# Usa TEST-xxx para pruebas, APP_USR-xxx para producción
# Si no se configura, el backend funciona en modo MOCK (preferencia fake)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
MERCADOPAGO_NOTIFICATION_URL=http://localhost:8080/pago/webhook
MERCADOPAGO_BACK_SUCCESS=http://localhost:3000/checkout/success
MERCADOPAGO_BACK_FAILURE=http://localhost:3000/checkout
MERCADOPAGO_BACK_PENDING=http://localhost:3000/checkout

# --- SMTP (opcional) ---
# Si defines SPRING_MAIL_HOST se envía el correo real; de lo contrario,
# el enlace de recuperación se registra en el log del backend.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=micorreo@gmail.com
SPRING_MAIL_PASSWORD=mi-app-password